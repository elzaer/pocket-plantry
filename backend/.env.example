# Open Food Facts write API — used server-side (pb_hooks) to contribute
# manually-entered products/photos back. Never expose these to the frontend.
OFF_USERNAME=
OFF_PASSWORD=

# Dev-only account seeding (pb_migrations/1784427210_seed_dev_accounts.js).
# Runs once, the first time this migration applies to a fresh pb_data.
# Leave blank in production — unset vars mean no accounts get seeded.
PB_DEV_SUPERUSER_EMAIL=
PB_DEV_SUPERUSER_PASSWORD=
PB_DEV_TEST_USER_EMAIL=
PB_DEV_TEST_USER_PASSWORD=
